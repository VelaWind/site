---
/**
 * One project card, used by /projects and by the home page.
 *
 * It is a component rather than markup repeated in two pages for the reason
 * the Vela Sea case study spends a section on: two copies of the same thing
 * agree until the day one of them is edited, and nothing reports the drift.
 */
import { Picture } from 'astro:assets';
import type { Project } from '../lib/projects';
import { STATUS_LABEL, STATUS_TOKEN } from '../lib/projects';

interface Props {
  project: Project;
  /** Heading level, so the card fits the outline of whichever page holds it. */
  level?: 2 | 3;
  /**
   * Whether this card's picture is wanted immediately. False everywhere except
   * the first card on /projects, which measurement put inside the opening
   * viewport at every width from 320px to 1920px; lazy-loading an image the
   * reader is already looking at only delays it.
   */
  eager?: boolean;
}

const { project, level = 2, eager = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';

/*
 * The screenshots are found by glob rather than imported one per project,
 * because the point of the optional field is that a card can gain a picture
 * without any other file being edited. Vite resolves this at build time, so
 * the images still go through the asset pipeline and still get hashed
 * filenames; nothing here is a runtime lookup.
 *
 * eager, because there are at most four of them and a lazy glob would hand back
 * a promise this component would then have to await for a value it needs during
 * render.
 */
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const shot = project.image ? shots[`/src/assets/projects/${project.image.file}`]?.default : undefined;

/*
 * Named but missing stops the build, on the same reasoning as the case-study
 * README fetch: the failure a silent fallback would hide is a card that was
 * meant to show the software and is quietly showing a coloured rectangle
 * instead, which looks identical to a card that was never given a picture.
 */
if (project.image && !shot) {
  throw new Error(
    `${project.name} names the screenshot "${project.image.file}", but ` +
      `src/assets/projects/${project.image.file} does not exist. Capture it to the ` +
      'spec in the README, or remove the image field from src/lib/projects.ts.',
  );
}

/*
 * The accent tint is set on whichever element ends up being the panel. On a
 * card with a picture it stays as the background behind it, so the space is
 * the card's own colour while the image is still arriving rather than a bare
 * hole; the picture covers it once it lands.
 */
const mediaStyle = project.accent ? `--card-accent: var(--${project.accent})` : undefined;

/*
 * Measured rather than guessed. The panel is at its widest, 671px, on a 720px
 * viewport: that is the last width before the grid takes a second column, and a
 * single column there is nearly the whole page. Above that it never exceeds
 * 530px, and on the home page's three-column line it is about 345px. 94vw
 * describes the first case and 34rem the second, so the browser is never told
 * to fetch an image larger than it is going to paint.
 *
 * The widths above follow from it: 700 serves the 671px panel on a 1x screen,
 * 1400 serves it on a 2x one, and 350 is the narrow-column case. There is no
 * 2100 because a 3x phone is never showing the 671px layout — that width only
 * happens on a tablet-sized viewport.
 */
const SIZES = '(min-width: 46rem) 34rem, 94vw';

// An off-site card says so in its own accessible name, so a reader using a
// screen reader learns where the link goes before following it rather than
// after. On-site case studies need no such warning: that is the default.
const away = !project.caseStudy;

// The scene key for the card's live drawing, derived from the name the same
// way a screenshot filename is. Only the fallback panel gets a scene: a real
// picture of the software beats a sketch of it.
const scene = project.name.toLowerCase().replace(/\s+/g, '-');
---

<li class="card" style={project.accent ? `--c: var(--${project.accent})` : undefined} data-anchor={project.anchor}>
  {
    shot ? (
      <Picture
        class="card-media"
        pictureAttributes={{ class: 'card-shot', style: mediaStyle }}
        src={shot}
        alt={project.image!.alt}
        widths={[350, 700, 1400]}
        sizes={SIZES}
        formats={['avif']}
        fallbackFormat="webp"
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <div class="card-media" style={mediaStyle} aria-hidden="true">
        <canvas class="card-scene" data-scene={scene}></canvas>
      </div>
    )
  }
  <div class="card-body">
    <Heading class="card-name">
      <a
        href={project.href}
        rel={away ? 'noopener' : undefined}
      >
        {project.name}{away && <span class="visually-hidden"> (source on GitHub)</span>}
      </a>
    </Heading>
    <p class="card-blurb">{project.blurb}</p>
    <ul class="card-tags">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="card-foot">
      {
        project.status && (
          <span class="card-status" style={`--status-color: var(${STATUS_TOKEN[project.status]})`}>
            {STATUS_LABEL[project.status]}
          </span>
        )
      }
      <span class="card-where">{project.caseStudy ? 'Case study' : 'Source'}</span>
    </p>
  </div>
</li>

<script>
  /*
   * The card scenes: each fallback media panel runs a slow live drawing of
   * what its project is. One shared requestAnimationFrame loop for all of
   * them — not one per card — and an IntersectionObserver stops any scene
   * that is off screen entirely, so the cost is one loop over the cards a
   * reader can actually see.
   *
   * The scene functions are pure (ctx, w, h, t, hot) and live in
   * src/scripts/sky/scenes.js where the tests can call them with a stub
   * context. Colour is set here, once per card, from the card's own --c — the
   * same resolved token the spotlight uses — so the palette still has exactly
   * one home.
   */
  import { SCENES } from '../scripts/sky/scenes.js';

  {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const canvases = [...document.querySelectorAll<HTMLCanvasElement>('.card-scene')];
    // Documented neutral, painted only if the token fails to resolve.
    const FALLBACK = '#8a919c';

    type Item = {
      canvas: HTMLCanvasElement;
      ctx: CanvasRenderingContext2D;
      fn: (ctx: CanvasRenderingContext2D, w: number, h: number, t: number, hot: number) => void;
      w: number;
      h: number;
      colour: string;
      active: boolean;
      hot: number;
    };

    const items: Item[] = [];
    for (const canvas of canvases) {
      const fn = SCENES[canvas.dataset.scene as keyof typeof SCENES];
      const ctx = canvas.getContext('2d');
      const card = canvas.closest('.card');
      if (!fn || !ctx || !(card instanceof HTMLElement)) continue;
      const item: Item = { canvas, ctx, fn, w: 0, h: 0, colour: FALLBACK, active: false, hot: 0 };

      // hot on hover AND focus-within: the keyboard reaches the card through
      // the name link, and the scene answering only the mouse would be the
      // tether bug all over again in miniature.
      card.addEventListener('mouseenter', () => { item.hot = 1; });
      card.addEventListener('mouseleave', () => { item.hot = card.matches(':focus-within') ? 1 : 0; });
      card.addEventListener('focusin', () => { item.hot = 1; });
      card.addEventListener('focusout', () => { item.hot = card.matches(':hover') ? 1 : 0; });

      items.push(item);
    }

    if (items.length) {
      const size = (item: Item) => {
        const box = item.canvas.getBoundingClientRect();
        item.w = box.width;
        item.h = box.height;
        const dpr = Math.min(2, devicePixelRatio || 1);
        item.canvas.width = Math.round(item.w * dpr);
        item.canvas.height = Math.round(item.h * dpr);
        item.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const card = item.canvas.closest('.card');
        if (card) item.colour = getComputedStyle(card).getPropertyValue('--c').trim() || FALLBACK;
      };

      const draw = (item: Item, t: number) => {
        item.ctx.clearRect(0, 0, item.w, item.h);
        item.ctx.strokeStyle = item.colour;
        item.ctx.fillStyle = item.colour;
        item.ctx.lineWidth = 1;
        item.fn(item.ctx, item.w, item.h, t, item.hot);
      };

      let raf = 0;
      const loop = (now: number) => {
        raf = 0;
        let any = false;
        for (const item of items) {
          if (!item.active) continue;
          any = true;
          draw(item, now / 1000);
        }
        if (any && !still.matches && !document.hidden) raf = requestAnimationFrame(loop);
      };
      const wake = () => {
        if (!raf && !still.matches && !document.hidden) raf = requestAnimationFrame(loop);
      };

      // Under reduce a scene is one still, mid-cycle rather than at t=0 so it
      // shows its subject and not its empty first frame.
      const settle = () => { for (const item of items) draw(item, 7); };

      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const item = items.find((i) => i.canvas === entry.target);
          if (item) item.active = entry.isIntersecting;
        }
        if (still.matches) settle();
        else wake();
      });

      for (const item of items) { size(item); io.observe(item.canvas); }
      if (still.matches) settle();

      document.addEventListener('visibilitychange', wake);
      still.addEventListener('change', () => (still.matches ? settle() : wake()));

      let timer = 0;
      addEventListener('resize', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          for (const item of items) size(item);
          if (still.matches) settle(); else wake();
        }, 150) as unknown as number;
      });

      // A theme change moves --c with it; recolour without waiting for a frame.
      new MutationObserver(() => {
        for (const item of items) size(item);
        if (still.matches) settle(); else wake();
      }).observe(document.documentElement, { attributeFilter: ['data-theme'] });
    }
  }
</script>

<script>
  /*
   * The spotlight. There is no CSS way to ask where the pointer is, so this
   * writes two custom properties and does nothing else: no state, no classes,
   * no layout reads beyond the card's own box.
   *
   * The stylesheet, not this file, decides whether any of it is visible. Every
   * rule it feeds sits behind prefers-reduced-motion, hover and pointer: fine,
   * so a reader who has asked for stillness sees nothing move even while this
   * runs, and a reader with JavaScript off gets the centred fallback position
   * baked into the gradient.
   *
   * pointer: fine is checked before listening because a touch screen has no
   * pointer to follow, and a tap would otherwise leave a card lit with a
   * spotlight frozen wherever the finger last was.
   */
  if (matchMedia('(pointer: fine)').matches) {
    for (const card of document.querySelectorAll('.card')) {
      if (!(card instanceof HTMLElement)) continue;
      card.addEventListener(
        'pointermove',
        (event) => {
          // Read the box per event rather than caching it: cards reflow on
          // resize and on a grid column change, and a cached rect would put the
          // light in the wrong place with nothing to say it had.
          const box = card.getBoundingClientRect();
          card.style.setProperty('--px', `${((event.clientX - box.left) / box.width) * 100}%`);
          card.style.setProperty('--py', `${((event.clientY - box.top) / box.height) * 100}%`);
        },
        { passive: true },
      );
    }
  }
</script>
