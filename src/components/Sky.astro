---
/**
 * The sky behind the page.
 *
 * VelaWind is a catalogued object: the pulsar wind nebula in Vela, the sails
 * of the old ship Argo Navis. So this is not a decorative particle field — it
 * is that patch of the southern sky, Vela, Carina and Puppis at their real
 * positions, with the four projects anchored to four real stars in it, and
 * the page is revealed by the shockwave of the supernova that made the
 * nebula. The data and the timings live in src/scripts/sky/, where Node can
 * import them and the tests can check the geometry against the catalogue.
 *
 * The component is one canvas and one import; everything else is the module's
 * business.
 */
---

<canvas id="sky" aria-hidden="true"></canvas>

<script>
  import { mountSky } from '../scripts/sky/sky.js';

  const canvas = document.querySelector<HTMLCanvasElement>('#sky');
  if (canvas) mountSky(canvas);
</script>
