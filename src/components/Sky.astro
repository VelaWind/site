---
/**
 * The sky behind the page, and the Vela constellation drawn on it.
 *
 * This is the one decorative thing on the site, and it earns its place by being
 * about something: Vela is where the handle comes from. So it is drawn from the
 * real positions of the six brightest stars in the constellation rather than
 * from six points that looked right, and it stays quiet — amber, low alpha, no
 * sound, no bounce, and nothing that moves unless the reader allows motion.
 *
 * It is a component rather than markup in the layout because the canvas and the
 * only code that touches it belong together.
 */
---

<canvas id="sky" aria-hidden="true"></canvas>

<script>
  /*
   * Every colour here is read from the stylesheet rather than written here, so
   * the sky is themed by the same tokens as everything else and a change to the
   * palette reaches it without this file being touched.
   */
  const canvas = document.querySelector<HTMLCanvasElement>('#sky');
  const context = canvas?.getContext('2d');

  if (canvas && context) {
    const ctx = context;
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    /*
     * The six brightest stars of Vela, from their right ascension and
     * declination, normalised into a unit box: gamma, delta, lambda, kappa, psi
     * and mu Velorum. x runs east-to-west so the figure sits the way it does in
     * the sky rather than mirrored, and the segments are the conventional
     * asterism, the one that makes the shape read as a sail.
     */
    const VELA = [
      { x: 1.0, y: 0.469 },   // gamma Velorum, the brightest
      { x: 0.772, y: 0.979 }, // delta
      { x: 0.627, y: 0.2 },   // lambda (Suhail)
      { x: 0.536, y: 1.0 },   // kappa (Markeb)
      { x: 0.0, y: 0.614 },   // mu
      { x: 0.479, y: 0.0 },   // psi
    ];
    const SEGMENTS = [[0, 1], [1, 3], [3, 4], [4, 5], [5, 2], [2, 0]];

    let stars: { x: number; y: number; r: number; a: number; rate: number; phase: number; z: number }[] = [];
    let w = 0;
    let h = 0;
    let px = 0;
    let py = 0;
    let lit = 0;
    let raf = 0;
    let sky = '';
    let skyAlpha = 1;
    let vela = '';
    let mono = '';

    const readTheme = () => {
      const cs = getComputedStyle(document.documentElement);
      sky = cs.getPropertyValue('--sky-star').trim();
      skyAlpha = Number(cs.getPropertyValue('--sky-alpha')) || 1;
      vela = cs.getPropertyValue('--star').trim();
      mono = cs.getPropertyValue('--font-mono').trim();
    };

    const init = () => {
      /*
       * The canvas's own box, not innerWidth. A fixed element inset to 0 stops
       * at the scrollbar, so the two differ by about 15px on a desktop: sizing
       * the backing store from innerWidth left it wider than the box it is
       * painted into, and the browser squashed the whole field by a percent and
       * a half to fit. The star count still comes from innerWidth, which is
       * what "roughly innerWidth over nine" asked for.
       */
      const box = canvas.getBoundingClientRect();
      w = box.width;
      h = box.height;
      // Capped at 2: past that the extra pixels cost real work and buy nothing
      // a reader can see on a field of one-pixel dots.
      const dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(150, Math.round(innerWidth / 9));
      stars = Array.from({ length: count }, () => ({
        x: Math.random(),
        y: Math.random(),
        r: 0.4 + Math.random(),
        a: 0.25 + Math.random() * 0.55,
        rate: 0.0004 + Math.random() * 0.0011,
        phase: Math.random() * Math.PI * 2,
        // Depth. Near stars move most under the pointer, far ones barely at all.
        z: 0.15 + Math.random() * 0.85,
      }));
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, w, h);

      ctx.fillStyle = sky;
      for (const s of stars) {
        // Twinkle is a slow breath, not a blink: alpha never drops below 70%.
        const twinkle = still.matches ? 1 : 0.7 + 0.3 * Math.sin(time * s.rate + s.phase);
        ctx.globalAlpha = s.a * skyAlpha * twinkle;
        ctx.beginPath();
        ctx.arc(s.x * w + px * s.z, s.y * h + py * s.z, s.r, 0, Math.PI * 2);
        ctx.fill();
      }

      if (lit > 0) {
        // The figure is placed in the upper right, held off the edges, and
        // scaled to the smaller axis so it keeps its shape on any window.
        const size = Math.min(w, h) * 0.24;
        const ox = w - size - Math.min(w * 0.12, 140);
        const oy = Math.min(h * 0.16, 120);
        const at = (p: { x: number; y: number }) => [ox + p.x * size, oy + p.y * size] as const;
        const t = Math.min(1, lit / 20);

        ctx.strokeStyle = vela;
        ctx.fillStyle = vela;
        ctx.lineWidth = 1;
        ctx.globalAlpha = 0.28 * t;
        for (const [a, b] of SEGMENTS) {
          const [x1, y1] = at(VELA[a]);
          const [x2, y2] = at(VELA[b]);
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.stroke();
        }

        for (const p of VELA) {
          const [x, y] = at(p);
          const halo = ctx.createRadialGradient(x, y, 0, x, y, 9);
          halo.addColorStop(0, vela);
          halo.addColorStop(1, 'transparent');
          ctx.globalAlpha = 0.22 * t;
          ctx.fillStyle = halo;
          ctx.beginPath();
          ctx.arc(x, y, 9, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 0.75 * t;
          ctx.fillStyle = vela;
          ctx.beginPath();
          ctx.arc(x, y, 1.6, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.globalAlpha = 0.5 * t;
        ctx.font = `12px ${mono}`;
        ctx.fillText('VELA — the sails', ox, oy + size + 22);
      }

      ctx.globalAlpha = 1;
    };

    const loop = (time: number) => {
      if (lit > 0 && lit < 20) lit += 1;
      draw(time);
      raf = requestAnimationFrame(loop);
    };

    const start = () => {
      // Under reduce there is one frame and no loop, ever. The constellation
      // still lights: it arrives at full strength instead of fading in, which
      // is the accommodation, not the removal of the feature.
      cancelAnimationFrame(raf);
      raf = 0;
      if (still.matches) draw(0);
      else raf = requestAnimationFrame(loop);
    };

    readTheme();
    init();
    start();

    addEventListener('resize', () => {
      init();
      if (!raf) draw(0);
    });

    // Nothing to animate for a tab nobody is looking at.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
      } else start();
    });

    if (!still.matches) {
      addEventListener('pointermove', (event) => {
        // Offset from the centre, at most 14px for the nearest star.
        px = (event.clientX / w - 0.5) * -28;
        py = (event.clientY / h - 0.5) * -28;
      }, { passive: true });
    }

    // A theme change rewrites the tokens; re-read them and repaint. The loop
    // would pick it up on its own, but under reduce there is no loop.
    const retheme = () => { readTheme(); if (!raf) draw(0); };
    new MutationObserver(retheme).observe(document.documentElement, { attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', retheme);

    still.addEventListener('change', start);

    document.addEventListener('vela:light', () => {
      lit = still.matches ? 20 : Math.max(lit, 1);
      if (!raf) draw(0);
    });
  }
</script>
