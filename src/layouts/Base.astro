---
/**
 * The shared document. Both routes use it.
 *
 * There is no `client:` directive anywhere in this layout or in either page, so
 * the rendered output is HTML and CSS with no script tag of any kind.
 */
import '../styles/global.css';
import { EMAIL, GITHUB } from '../lib/site';
import Sky from '../components/Sky.astro';
import Eggs from '../components/Eggs.astro';

interface Props {
  title: string;
  description: string;
  /**
   * What the page is, for the unfurl. A case study is an article; the front
   * page and the index are not.
   */
  type?: 'website' | 'article';
  /**
   * How much sky this page gets: 1 on the home page, 0.7 on the index, 0.35
   * behind a case study, where someone is reading two thousand words and the
   * sky's job is to be almost absent. A prop rather than a body data
   * attribute because the pages already talk to Base through props, and a
   * number a stylesheet can consume beats an attribute a stylesheet would
   * have to enumerate.
   */
  sky?: number;
}

const { title, description, type = 'website', sky = 1 } = Astro.props;

const site = Astro.site ?? new URL('https://velawind.dev');

/*
 * The trailing slash is stripped deliberately. Astro builds directories, so
 * Astro.url.pathname is "/projects/lodestar/", and vercel.json sets
 * trailingSlash: false, so that address answers 308 and redirects. A canonical
 * that redirects is untidy; an og:url that redirects is worse, because a
 * scraper follows it and can cache the page under the wrong address.
 */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, site);

/*
 * The card drops the site name from the title, because og:site_name already
 * carries it and "Lodestar · VelaWind — VelaWind" is what happens otherwise.
 */
const cardTitle = title.replace(/\s+·\s+VelaWind$/, '');

/*
 * Absolute, and it has to be: a relative og:image is ignored by every scraper
 * there is. That is the failure mode where the markup looks right and no card
 * ever appears.
 */
const ogImage = new URL('/og.png', site);
const ogImageAlt =
  'The VelaWind wordmark in light type on a dark field, above the line: ' +
  'Four projects, each answerable to something outside itself: SI constants, ' +
  'the maritime collision rules, database constraints, the filesystem.';

/*
 * The AI-assistance disclosure, mirroring the wording on Lodestar's own About
 * page ("Built solo, with an AI pair": decisions stay with the author, the AI
 * drafts to that direction, and nothing ships unread).
 */
const aiDisclosure =
  'Built solo in collaboration with Claude Code: the decisions stay with the ' +
  'author, the AI drafts to that direction, and nothing ships unread.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />

    {/*
      The unfurl. This site's job is to be pasted into an application, a message
      or a mail body, and without these it arrives as a bare URL next to other
      people's cards.

      Every URL here is absolute. og:image especially: a relative one is
      discarded by every scraper, and the symptom is a card with no picture and
      nothing in the markup that looks wrong.

      The values are per route because Base is given the page's own title and
      description, so a shared case study unfurls as itself rather than as the
      front page.
    */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="VelaWind" />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cardTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/*
      The one render-blocking script on this site, and it is correct here for a
      reason that does not generalise.

      Everything else the site does can wait: it is deferred, or it is CSS, or
      it does not exist. This cannot wait. The stored theme has to be on the
      root element before the first paint, because the alternative is painting
      the device's theme and then correcting it, which is the white flash every
      reader of a dark site knows. A deferred script runs after that paint. The
      cost of blocking here is a few hundred bytes parsed before layout, and it
      buys the absence of the one visual defect a theme toggle can introduce.

      It is inline rather than a file for the same reason: a request would put
      the network between the reader and the first frame.

      `is:inline` keeps Astro from hoisting and bundling it into a module,
      which would make it deferred and defeat the whole point.

      The try/catch is not decoration. Reading localStorage throws outright in
      some privacy modes, and an exception here would stop the script before it
      set data-js, leaving the toggle permanently hidden.
    */}
    <script is:inline>
      try {
        var stored = localStorage.getItem('velawind-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {
        /* No storage: fall through to the device preference, which is the
           same state as a reader who has never chosen. */
      }
      /* Tells the stylesheet a script is running, so the toggle can be shown.
         Set unconditionally, and outside the try, so a storage failure never
         hides a control that still works. */
      document.documentElement.dataset.js = '';

      /*
       * Arms the arrival sequence, and only here: the CSS that hides the page
       * pre-reveal is keyed to data-arrive, so the hidden state can only ever
       * exist when this script has run and motion is allowed. Get this the
       * right way round — the reveal classes default to VISIBLE — and a
       * reader with no JavaScript, or a crawler, or a print job, never has
       * anything to un-hide.
       *
       * The failsafe is armed in the same breath, before the sky module has
       * had any chance to fail: whatever happens to the sequence, at 4s the
       * page is fully on. A JS error must not be able to make the site
       * invisible, and this line is that sentence in code.
       */
      try {
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          document.documentElement.dataset.arrive = '';
          setTimeout(function () {
            document.documentElement.dataset.arriveGo = '';
          }, 4000);
        }
      } catch (e) {
        /* matchMedia failing means no hidden state was created at all. */
      }
    </script>
  </head>
  <body style={sky === 1 ? undefined : `--sky-intensity: ${sky}`}>
    <a class="skip" href="#main">Skip to content</a>
    <Sky />
    {/*
      Decorative only: it reports the scroll position the scrollbar already
      shows, so it is hidden from assistive technology. It lives here rather
      than in the pages that wanted it because every route can be scrolled, and
      a bar that appears on two of four reads as a bug on the other two. On a
      page short enough not to scroll, the timeline never starts and it stays
      invisible. Driven entirely by `animation-timeline: scroll()` in the
      stylesheet; nothing here needs script.
    */}
    <div class="reading-progress" aria-hidden="true"></div>

    {/*
      Three states, not two: light, dark, and the absence of a choice. The
      third is not a formality — it is the only one that keeps following the
      device after the reader changes it, and it is the state every reader
      starts in, so removing it would mean the first click permanently opts
      someone out of their own system setting.

      The label says which state the button is in, because "Toggle theme" tells
      a reader who cannot see the glyph nothing about what they are currently
      looking at. It is rendered here for the no-choice state and corrected by
      the script below when a stored choice says otherwise.
    */}
    {/*
      The two controls that belong to the site rather than to a page, so they
      sit together on every route. The home page is the only one with a header
      to put them in; everywhere else there is none, and a control that appears
      on one route in four is worse than one that is always in the same corner.
    */}
    <div class="controls">
    <button
      class="theme-toggle"
      type="button"
      aria-label="Theme: following your device. Change theme."
    >
      {/* Decorative: the label carries the meaning. */}
      <svg data-glyph="system" viewBox="0 0 24 24" aria-hidden="true" fill="none"
        stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <circle cx="12" cy="12" r="8"></circle>
        <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none"></path>
      </svg>
      <svg data-glyph="light" viewBox="0 0 24 24" aria-hidden="true" fill="none"
        stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <circle cx="12" cy="12" r="4.5"></circle>
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
      </svg>
      <svg data-glyph="dark" viewBox="0 0 24 24" aria-hidden="true" fill="none"
        stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
      </svg>
    </button>

      <button class="palette-open" type="button" aria-haspopup="dialog" hidden>
        <span class="palette-key" data-mac="⌘K" data-other="Ctrl K">⌘K</span>
      </button>
    </div>

    {/*
      The command palette. Every row is an ordinary link or an ordinary button,
      not a div with a click handler, so activating one is the browser doing
      what it always does and the script never has to reimplement navigation.

      It is a shortcut and never the only way. Each row has a plain equivalent
      in the page: the section links are the home nav, the address and the
      GitHub link are both in the contact section, and the theme row presses the
      button next to this one. Copying to the clipboard is the single action
      that cannot exist without script, and the address it copies is on the page
      as selectable text, which is the ordinary way to do the same thing.

      <dialog> rather than a div: showModal() gives the focus trap, Escape, the
      inert background and the return of focus to whatever opened it, all as
      browser behaviour rather than as a hand-rolled trap that will be subtly
      wrong. role and aria-modal are stated anyway, as asked; they match what
      the element already means.
    */}
    <dialog class="palette" id="palette" role="dialog" aria-modal="true" aria-label="Command palette">
      <input
        class="palette-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        placeholder="Type to filter…"
        autocomplete="off"
        autofocus
      />
      <ul class="palette-list" id="palette-list" role="listbox" aria-label="Actions">
        <li><a id="pal-work" role="option" aria-selected="false" href="/#work">Jump to Work</a></li>
        <li><a id="pal-building" role="option" aria-selected="false" href="/#building">Jump to Building</a></li>
        <li><a id="pal-about" role="option" aria-selected="false" href="/#about">Jump to About</a></li>
        <li><a id="pal-contact" role="option" aria-selected="false" href="/#contact">Jump to Contact</a></li>
        <li><a id="pal-email" role="option" aria-selected="false" href={`mailto:${EMAIL}`}>Email me <span class="palette-hint">{EMAIL}</span></a></li>
        <li><a id="pal-github" role="option" aria-selected="false" href={GITHUB}>Open GitHub <span class="palette-hint">github.com/velawind</span></a></li>
        <li><button id="pal-theme" role="option" aria-selected="false" type="button" data-action="theme">Toggle theme</button></li>
        <li><button id="pal-copy" role="option" aria-selected="false" type="button" data-action="copy">Copy email to clipboard</button></li>
        <li><button id="pal-vela" role="option" aria-selected="false" type="button" data-action="vela">Light the Vela constellation</button></li>
      </ul>
      <p class="palette-empty" hidden></p>
      <p class="palette-status" role="status"></p>
    </dialog>

    <slot />
    <Eggs />
    {/*
      The disclosure only. The name is the h1 on the home page and the eyebrow
      on every other route, so a line here was a third copy of it.
    */}
    {/*
      The disclosure, and the two links the command palette offers from every
      route. They are here because of what the palette promised: a shortcut may
      never be the only way to reach something. Without these, a reader with
      JavaScript off standing on a case study had no address and no repository
      link on the page at all, while a reader with it had both. The name is not
      repeated here; it is the h1 on the home page and the eyebrow elsewhere.
    */}
    <footer class="site-footer">
      <p>{aiDisclosure}</p>
      <p class="site-footer-links">
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href={GITHUB} rel="me">github.com/velawind</a>
        <button class="vela-light" type="button">Light the Vela constellation</button>
      </p>
    </footer>

    <script>
      /*
       * The toggle's behaviour. Deferred, unlike the script in the head: none
       * of this has to happen before the first paint, because the head script
       * has already put the page in the right theme and the stylesheet has
       * already chosen the right glyph from the attribute.
       *
       * Which glyph shows is CSS's job, not this file's. All this does is move
       * between three states, write the choice down, and keep the label
       * honest.
       */
      type ThemeState = 'system' | 'light' | 'dark';

      const KEY = 'velawind-theme';
      const ORDER: ThemeState[] = ['system', 'light', 'dark'];
      const LABEL: Record<ThemeState, string> = {
        system: 'Theme: following your device. Change theme.',
        light: 'Theme: light. Change theme.',
        dark: 'Theme: dark. Change theme.',
      };

      const root = document.documentElement;
      const button = document.querySelector('.theme-toggle');

      if (button instanceof HTMLElement) {
        const read = (): ThemeState => {
          const set = root.dataset.theme;
          return set === 'light' || set === 'dark' ? set : 'system';
        };

        const apply = (state: ThemeState) => {
          if (state === 'system') {
            delete root.dataset.theme;
          } else {
            root.dataset.theme = state;
          }
          button.setAttribute('aria-label', LABEL[state]);
          try {
            // "system" is stored as an absence, so a reader who returns to it
            // is in the same state as one who never chose.
            if (state === 'system') localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, state);
          } catch (e) {
            /* Storage refused. The choice still applies for this page view,
               which is better than refusing to switch at all. */
          }
        };

        // The markup is rendered with the no-choice label; correct it if the
        // head script found a stored choice.
        button.setAttribute('aria-label', LABEL[read()]);

        button.addEventListener('click', () => {
          apply(ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length]);
        });
      }

      // The plain equivalent of the palette's constellation row.
      document.querySelector('.vela-light')?.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('vela:light'));
      });
    </script>

    <script>
      /*
       * The command palette. Everything it can do is reachable without it, so
       * this file is allowed to be small: the rows are real links and buttons,
       * activating one is row.click(), and <dialog>.showModal() supplies the
       * focus trap, Escape and the return of focus that would otherwise be most
       * of the code here.
       */
      import { EMAIL } from '../lib/site';

      const palette = document.querySelector('.palette');
      const opener = document.querySelector('.palette-open');

      if (palette instanceof HTMLDialogElement && opener instanceof HTMLElement) {
        const input = palette.querySelector('.palette-input') as HTMLInputElement;
        const empty = palette.querySelector('.palette-empty') as HTMLElement;
        const status = palette.querySelector('.palette-status') as HTMLElement;
        const rows = [...palette.querySelectorAll<HTMLElement>('[role="option"]')];
        let active = 0;

        // The key legend is the one thing that cannot be decided at build time.
        const mac = /mac|iphone|ipad/i.test(navigator.platform || navigator.userAgent);
        const key = opener.querySelector('.palette-key') as HTMLElement;
        key.textContent = mac ? key.dataset.mac! : key.dataset.other!;
        opener.setAttribute('aria-label', `Open the command palette (${key.textContent})`);
        opener.hidden = false;

        /*
         * Match the action's name, not the whole row. The hints are an address
         * and a URL, and on a site called velawind both contain "vela": typing
         * it matched three rows and put Email first, so Enter opened a mail
         * client instead of lighting the constellation. Computed once here
         * rather than on every keystroke.
         */
        rows.forEach((row) => {
          const hint = row.querySelector('.palette-hint')?.textContent ?? '';
          row.dataset.label = row.textContent!.replace(hint, '').trim().toLowerCase();
        });

        const shown = () => rows.filter((row) => !row.hidden);

        const select = (index: number) => {
          const list = shown();
          rows.forEach((row) => row.setAttribute('aria-selected', 'false'));
          if (!list.length) return input.removeAttribute('aria-activedescendant');
          active = (index + list.length) % list.length;
          const row = list[active];
          row.setAttribute('aria-selected', 'true');
          // Focus stays in the input; this is what tells a screen reader which
          // row is current, and it is why the rows are options and not links
          // as far as assistive technology is concerned.
          input.setAttribute('aria-activedescendant', row.id);
          row.scrollIntoView({ block: 'nearest' });
        };

        const filter = () => {
          const query = input.value.trim().toLowerCase();
          rows.forEach((row) => {
            row.hidden = query !== '' && !row.dataset.label!.includes(query);
          });
          // Never a blank box: an empty result says so and suggests a way out.
          empty.hidden = shown().length > 0;
          empty.textContent = `Nothing matches “${input.value.trim()}”. Try work, email, theme or GitHub.`;
          select(0);
        };

        const open = () => {
          input.value = '';
          status.textContent = '';
          filter();
          palette.showModal();
        };

        opener.addEventListener('click', open);

        addEventListener('keydown', (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            palette.open ? palette.close() : open();
          }
        });

        input.addEventListener('input', filter);

        input.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            select(active + (event.key === 'ArrowDown' ? 1 : -1));
          } else if (event.key === 'Enter') {
            event.preventDefault();
            shown()[active]?.click();
          }
        });

        // showModal() returns focus to whatever was focused before it opened,
        // which after the keyboard shortcut is nothing at all. Naming the
        // trigger makes the return the same however it was opened.
        palette.addEventListener('close', () => opener.focus());

        palette.addEventListener('click', async (event) => {
          const target = event.target as HTMLElement;
          // A click on the dialog itself landed on the backdrop: the rows are
          // all inside it, so nothing was hit.
          if (target === palette) return palette.close();

          // A link row navigates on its own. Close it so a same-page jump does
          // not leave the palette sitting over the section it just moved to.
          if (target.closest('a[role="option"]')) return palette.close();

          const row = target.closest<HTMLElement>('[data-action]');
          if (!row) return;
          if (row.dataset.action === 'theme') {
            document.querySelector<HTMLElement>('.theme-toggle')?.click();
            status.textContent = 'Theme changed.';
            return;
          }
          if (row.dataset.action === 'vela') {
            document.dispatchEvent(new CustomEvent('vela:light'));
            status.textContent = 'Vela is lit, upper right.';
            return;
          }
          try {
            await navigator.clipboard.writeText(EMAIL);
            status.textContent = `Copied ${EMAIL} to the clipboard.`;
          } catch {
            // Denied, or no clipboard. Say so rather than appearing to work.
            status.textContent = `Could not copy. The address is ${EMAIL}.`;
          }
        });
      }
    </script>
  </body>
</html>
