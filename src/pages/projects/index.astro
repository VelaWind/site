---
/**
 * The case-study index: one card per project that has a case study on this
 * site. Projects without one live on the home page, where a card can point at
 * a repository; this route is the way into the case studies, so an entry here
 * without a page behind it would be a dead link.
 *
 * The card itself is a component shared with the home page, so the two cannot
 * drift apart.
 */
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { caseStudies } from '../../lib/projects';
---

<Base
  sky={0.7}
  title="Projects · VelaWind"
  description="Case studies for the things VelaWind has built."
>
  <main class="wrap" id="main">
    <p class="eyebrow"><a href="/">VelaWind</a></p>

    <h1>Projects</h1>

    <ul class="project-grid">
      {
        /*
         * The first card is eager, the rest lazy. Measured at every viewport
         * width from 320px to 1920px, this one's media is inside the opening
         * viewport at all of them, and lazy-loading a picture the reader is
         * already looking at only delays it. The home page passes nothing,
         * because its cards were below the fold at every width tested.
         */
        caseStudies.map((project, index) => (
          <ProjectCard project={project} eager={index === 0} />
        ))
      }
    </ul>
  </main>
</Base>
