---
/**
 * Home, deliberately a stub: the handle, one line, and the links out. No
 * positioning line until there is one worth writing.
 *
 * The projects link is the only route into the case studies, which were
 * otherwise reachable only by typing the URL. It is a link and not a list:
 * the list lives at /projects, where it can grow without this page growing.
 */
import Base from '../layouts/Base.astro';

// PLACEHOLDER: replace with the real handle-based address before launch.
// It is the only invented value on the site.
const email = 'hello@velawind.dev';
---

<Base
  title="VelaWind"
  description="VelaWind, computer science student."
>
  <main class="home" id="main">
    <h1>VelaWind</h1>
    <p class="muted">Computer science student.</p>
    <ul>
      <li><a href="/projects">Projects</a></li>
      <li><a href="https://github.com/velawind" rel="me">github.com/velawind</a></li>
      <li><a href={`mailto:${email}`}>{email}</a></li>
    </ul>
  </main>
</Base>
